<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Tiêu đề app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phân tích thiết bị và đề xuất thông số tối ưu cho Free Fire"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="10dp" />

        <!-- Trạng thái key + nút đăng xuất -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvLicenseStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/success_green"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/menu_logout"
                android:textAllCaps="false"
                android:textColor="@color/danger_red"
                android:textSize="11sp"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <!-- CardView: Thông tin thiết bị -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDeviceInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_device_info"
                    android:textColor="@color/accent_orange"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvDeviceInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhấn &quot;Phân tích thiết bị&quot; để bắt đầu"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Thanh loading -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:progressTint="@color/accent_purple"
            android:layout_marginBottom="16dp" />

        <!-- Nút phân tích -->
        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_analyze"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:background="@drawable/bg_button_primary"
            android:elevation="0dp"
            android:layout_marginBottom="14dp" />

        <!-- CardView: Kết quả đề xuất -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_result"
                    android:textColor="@color/success_green"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CardView: Tuỳ chỉnh nâng cao (công tắc + thanh kéo cho từng chức năng) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_advanced"
                    android:textColor="@color/accent_purple"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_advanced"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp" />

                <!-- Công tắc: Giảm animation -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAnimation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_animation"
                    android:textColor="@color/text_primary"
                    android:checked="true" />

                <TextView
                    android:id="@+id/tvAnimationValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tự động theo thiết bị"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <SeekBar
                    android:id="@+id/seekAnimation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="95"
                    android:progress="0"
                    android:progressTint="@color/accent_orange"
                    android:thumbTint="@color/accent_orange"
                    android:layout_marginBottom="12dp" />

                <!-- Công tắc: Giới hạn tiến trình nền -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swBackgroundLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_background_limit"
                    android:textColor="@color/text_primary"
                    android:checked="true" />

                <TextView
                    android:id="@+id/tvBackgroundLimitValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tự động theo thiết bị"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <SeekBar
                    android:id="@+id/seekBackgroundLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="7"
                    android:progress="0"
                    android:progressTint="@color/accent_orange"
                    android:thumbTint="@color/accent_orange"
                    android:layout_marginBottom="12dp" />

                <!-- Các công tắc đơn giản còn lại -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swTouchResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_touch"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swRefreshRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_refresh_rate"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swClearCache"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_clear_cache"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swGpuBoost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_gpu_boost"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swGameMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_game_mode"
                    android:textColor="@color/text_primary"
                    android:checked="false"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swKillBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/opt_kill_background"
                    android:textColor="@color/text_primary"
                    android:checked="false"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/warn_kill_background"
                    android:textColor="@color/danger_red"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hàng 2 nút: Áp dụng / Phục hồi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnApply"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/btn_apply"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:background="@drawable/bg_button_primary"
                android:elevation="0dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnRestore"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/btn_restore"
                android:textColor="@color/accent_purple"
                android:textSize="13sp"
                android:background="@drawable/bg_button_secondary"
                android:elevation="0dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Nút xem log lệnh đã chạy -->
        <Button
            android:id="@+id/btnToggleLog"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="@string/btn_show_log"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:background="@android:color/transparent"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- CardView: Lịch sử -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_history"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chưa có lịch sử tối ưu nào."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="6dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
